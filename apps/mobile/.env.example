# Hosted Supabase dev project (see CLAUDE.md → "Barındırılan dev projesi kurulumu").
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Without a key analytics does nothing (EU host by default).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Hosted privacy policy URL and contact address (both required for the stores).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_CONTACT_EMAIL=

# Optional. Without a DSN crash reporting does nothing. Only the user id is sent.
EXPO_PUBLIC_SENTRY_DSN=
# Optional (v2 map, not used yet). MapLibre style URL; no API key is built into the app.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Forced update screen: where "Güncelle" leads. Unset: the app's Play Store page. While testers
# install APKs from a link, put that link here (EAS build page).
EXPO_PUBLIC_UPDATE_URL=
