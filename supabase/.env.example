# Local Supabase only (read by the CLI for env() values in config.toml). Copy to supabase/.env.
# These are placeholders: locally only test_otp numbers are used and nothing reaches Twilio.
# Real Twilio credentials go into the hosted project's dashboard, never into this file.
SUPABASE_AUTH_SMS_TWILIO_VERIFY_ACCOUNT_SID=local-placeholder
SUPABASE_AUTH_SMS_TWILIO_VERIFY_MESSAGE_SERVICE_SID=local-placeholder
SUPABASE_AUTH_SMS_TWILIO_VERIFY_AUTH_TOKEN=local-placeholder
